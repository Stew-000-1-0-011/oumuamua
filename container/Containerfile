# ROS 2 Lyrical Luth (Ubuntu 26.04, GCC 15) development image for oumuamua.
# Plain Containerfile: builds with Podman/Buildah and Docker (BuildKit) alike.
#
# Behind a TLS-intercepting proxy, pass its CA certificate as a build secret:
#   podman build --secret id=extra_ca,src=/path/to/ca.crt ...
#   docker build --secret id=extra_ca,src=/path/to/ca.crt ...
# It is used only while the RUN steps fetch over HTTPS and is not stored in the image.

# Fully qualified so Podman does not depend on short-name resolution.
ARG BASE_IMAGE=docker.io/library/ros:lyrical
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="oumuamua" \
      org.opencontainers.image.description="ROS 2 Lyrical / C++26 build environment for oumuamua" \
      org.opencontainers.image.source="https://github.com/Stew-000-1-0-011/oumuamua"

ARG DEBIAN_FRONTEND=noninteractive

# Trust an optional extra CA (see above) for the current RUN only.
# Usage: RUN --mount=type=secret,id=extra_ca,required=false . /usr/local/bin/use-extra-ca && ...
RUN printf '%s\n' \
      'if [ -s /run/secrets/extra_ca ]; then' \
      '  cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-bundle.crt' \
      '  export SSL_CERT_FILE=/tmp/ca-bundle.crt REQUESTS_CA_BUNDLE=/tmp/ca-bundle.crt GIT_SSL_CAINFO=/tmp/ca-bundle.crt' \
      'fi' > /usr/local/bin/use-extra-ca

# Resolve package dependencies at image build time so the container is ready to build.
COPY src /tmp/oumuamua_src
RUN --mount=type=secret,id=extra_ca,required=false \
    . /usr/local/bin/use-extra-ca \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      ccache \
      git \
 && rosdep update --rosdistro "${ROS_DISTRO}" \
 && rosdep install --from-paths /tmp/oumuamua_src --ignore-src -y --rosdistro "${ROS_DISTRO}" \
 && rm -rf /tmp/oumuamua_src /tmp/ca-bundle.crt /var/lib/apt/lists/*

# sotoba (header-only, not in rosdep) for sotoba_ros. Its CMake also installs Sophus >= 1.24.6
# into the same prefix, since ROS's ros-lyrical-sophus (1.22) is too old.
ARG SOTOBA_REPO=https://github.com/Stew-000-1-0-011/sotoba.git
ARG SOTOBA_REF=main
RUN --mount=type=secret,id=extra_ca,required=false \
    . /usr/local/bin/use-extra-ca \
 && git clone --depth 1 --branch "${SOTOBA_REF}" "${SOTOBA_REPO}" /tmp/sotoba \
 && cmake -S /tmp/sotoba -B /tmp/sotoba/build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/sotoba -DBUILD_DEVS=OFF -DBUILD_EXAMPLES=OFF \
      -DBUILD_STATIC_LIB=OFF -DBUILD_SHARED_LIB=OFF -DBUILD_MODULE_LIB=OFF \
 && cmake --build /tmp/sotoba/build --target install \
 && rm -rf /tmp/sotoba /tmp/ca-bundle.crt
ENV CMAKE_PREFIX_PATH=/opt/sotoba

ENV COLCON_DEFAULTS_FILE=/ws/colcon_defaults.yaml
WORKDIR /ws

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
 && echo '[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash' >> /root/.bashrc
