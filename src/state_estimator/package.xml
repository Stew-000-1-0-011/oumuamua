<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>state_estimator</name>
  <version>0.0.0</version>
  <description>
    機体の平面姿勢と機体速度を推定するノード。下位層の機体速度で予測し、sotoba_node の事後分布で更新し、sotoba_node への事前分布と現在の推定 (Odometry, TF) を出す。
  </description>
  <maintainer email="shnsk0204@gmail.com">Stew</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>sotoba_ros</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
