<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>task_commander</name>
  <version>0.0.0</version>
  <description>
    機体に作業 (ブロックの回収、スラロームの往復、棚への配置、各地点への移動) を 1 つずつ指示するノード。
    走行は path_follower、把持機構は gripper_node に任せる。
  </description>
  <maintainer email="shnsk0204@gmail.com">Stew</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>gripper</depend>
  <depend>path_follower</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_test</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-matplotlib</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
