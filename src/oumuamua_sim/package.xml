<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oumuamua_sim</name>
  <version>0.0.0</version>
  <description>
    oumuamua の cmd_vel から先のシミュレータ。全方向移動ロボットの平面運動と、sotoba_ros と同じフィールドに対する 2D LiDAR を模擬する。
  </description>
  <maintainer email="shnsk0204@gmail.com">Stew</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>sotoba_ros</depend>

  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
