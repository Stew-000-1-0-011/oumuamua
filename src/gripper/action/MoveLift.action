# 昇降を目標の高さへ動かす。新しいゴールが来たら、前のゴールは打ち切る (aborted)
float64 height     # [m] 起動時の位置を 0 とした高さ
---
bool reached       # 目標に着いたか (打ち切り・取り消し・時間切れなら false)
float64 height     # [m] 終わったときの高さ (モータのフィードバックが無ければ指令値)
string message
---
float64 height     # [m] 今の高さ (モータのフィードバックが無ければ指令値)
float64 target     # [m] 今送っている位置指令 (最高速度でゴールへ向けて動かしている途中の値)
